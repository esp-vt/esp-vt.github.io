---
interface Props {
  title: string;
  description: string;
  tags: string[];
  category?: string;
  github?: string;
  demo?: string;
  paper?: string;
  slides?: string;
  idKey?: string;
}

const { title, description, tags, category = 'Project', github, demo, paper, slides, idKey } = Astro.props;

// Compute translation keys if idKey is available or fallback
const autoIdKey = idKey || (
  title.toLowerCase().includes('telepathy') ? 'telepathy' :
  title.toLowerCase().includes('empirical') || title.toLowerCase().includes('ispass') || title.toLowerCase().includes('serving') ? 'ispass' :
  undefined
);
---

<div class="card project-card">
  <div class="card-header">
    <span class="badge category-badge" data-i18n={autoIdKey ? `proj.${autoIdKey}.cat` : undefined}>{category}</span>
    <div class="links-group">
      {paper && (
        <a href={paper} target="_blank" rel="noopener noreferrer" class="link-btn" title="Paper / Citation">
          <span data-i18n="projects.paper">Paper</span> ↗
        </a>
      )}
      {slides && (
        <a href={slides} target="_blank" rel="noopener noreferrer" class="link-btn" title="Presentation Slides">
          <span data-i18n="projects.slides">Slides</span> ↗
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="link-btn" title="GitHub Repository">
          <span>GitHub</span> ↗
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="link-btn" title="Live Demo">
          <span data-i18n="projects.live_demo">Demo</span> ↗
        </a>
      )}
    </div>
  </div>

  <h3 class="project-title" data-i18n={autoIdKey ? `proj.${autoIdKey}.title` : undefined}>{title}</h3>
  <p class="project-desc" data-i18n={autoIdKey ? `proj.${autoIdKey}.desc` : undefined}>{description}</p>

  <div class="tags-container">
    {tags.map((tag) => (
      <span class="tech-tag">{tag}</span>
    ))}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-secondary);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-badge {
    text-transform: uppercase;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .links-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .link-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .link-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background-color: var(--bg-tertiary);
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.45rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.1rem;
    flex: 1;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-tertiary);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
  }
</style>

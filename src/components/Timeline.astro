---
interface TimelineItem {
  period: string;
  titleKey: string;
  title: string;
  orgKey: string;
  organization: string;
  descKey: string;
  description: string;
  tags?: string[];
  type?: 'research' | 'education' | 'work';
}

const timelineData: TimelineItem[] = [
  {
    period: '2024 - Present',
    titleKey: 'timeline.phd_title',
    title: 'Ph.D. 과정 & 대학원 연구원',
    orgKey: 'timeline.phd_org',
    organization: 'Virginia Tech (CS / ECE)',
    descKey: 'timeline.phd_desc',
    description: '하드웨어 앵커 기반 기밀 머신러닝(ConfML-Trust), 비우회적 데이터 프로비넌스 측정, AMD SEV-SNP / Intel TDX 및 NVIDIA Hopper H100 CC 연동 보안 LLM 파인튜닝 연구 수행.',
    tags: ['TEE', 'AMD SEV-SNP', 'Intel TDX', 'Hopper H100 CC', 'Confidential ML', 'Data Provenance', 'PyTorch'],
    type: 'research',
  },
  {
    period: '2018 - 2022',
    titleKey: 'timeline.bs_title',
    title: '컴퓨터공학 학사 (B.S.)',
    orgKey: 'timeline.bs_org',
    organization: '컴퓨터공학과 학부 과정',
    descKey: 'timeline.bs_desc',
    description: '운영체제(OS), 컴퓨터 구조, 암호학, 분산 시스템, 네트워크 보안 및 딥러닝 알고리즘 이수.',
    tags: ['Systems', 'OS', 'Algorithms', 'C/C++', 'Python', 'Security'],
    type: 'education',
  },
];
---

<div class="timeline-container">
  {timelineData.map((item, index) => (
    <div class="timeline-item">
      <div class="timeline-marker">
        <div class="marker-dot"></div>
        {index !== timelineData.length - 1 && <div class="marker-line"></div>}
      </div>

      <div class="timeline-content card">
        <div class="content-header">
          <span class="period-badge">{item.period}</span>
          <span class="type-badge">{item.type}</span>
        </div>
        <h4 class="item-title" data-i18n={item.titleKey}>{item.title}</h4>
        <div class="item-org" data-i18n={item.orgKey}>{item.organization}</div>
        <p class="item-desc" data-i18n={item.descKey}>{item.description}</p>
        {item.tags && (
          <div class="item-tags">
            {item.tags.map((tag) => (
              <span class="tech-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    flex-shrink: 0;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-gradient);
    border: 3px solid var(--bg-primary);
    box-shadow: 0 0 0 2px var(--accent-primary);
    z-index: 2;
    margin-top: 1.5rem;
  }

  .marker-line {
    flex: 1;
    width: 2px;
    background-color: var(--border-color);
    margin-top: 0.25rem;
  }

  .timeline-content {
    flex: 1;
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .period-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-primary);
  }

  .type-badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-tertiary);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
  }

  .item-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .item-org {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .item-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-tertiary);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
  }

  @media (max-width: 640px) {
    .timeline-marker {
      display: none;
    }
    .timeline-item {
      gap: 0;
    }
  }
</style>

---
import { LANGUAGES } from '../site.config';
---

<div class="multilang-reader-bar card">
  <div class="reader-header">
    <div class="reader-icon-title">
      <span class="globe-anim">🌐</span>
      <span class="reader-title" data-i18n="post.translate_notice">언어별 실시간 번역 열람:</span>
    </div>
    <span class="badge ai-badge">Instant 6-Language Translation</span>
  </div>

  <div class="lang-pills">
    {LANGUAGES.map((lang) => (
      <button
        class="lang-pill-btn"
        data-target-lang={lang.code}
        type="button"
        title={`Translate to ${lang.label} (${lang.nativeName})`}
      >
        <span class="pill-flag">{lang.flag}</span>
        <span class="pill-text">{lang.nativeName}</span>
      </button>
    ))}
  </div>
  
  <div id="translation-status" class="translation-status hidden">
    <span class="status-dot"></span>
    <span class="status-msg">Translating article...</span>
  </div>
</div>

<style>
  .multilang-reader-bar {
    margin-bottom: 2rem;
    padding: 1.1rem 1.35rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
  }

  .reader-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .reader-icon-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .globe-anim {
    font-size: 1.1rem;
  }

  .ai-badge {
    font-size: 0.7rem;
  }

  .lang-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lang-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-full);
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    font-size: 0.82rem;
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .lang-pill-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .lang-pill-btn.active {
    background: var(--accent-gradient);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 2px 8px var(--accent-glow);
  }

  .pill-flag {
    font-size: 0.95rem;
  }

  .translation-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-color);
  }

  .translation-status.hidden {
    display: none;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-primary);
    animation: pulse 1s infinite alternate;
  }

  @keyframes pulse {
    from { opacity: 0.3; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1.2); }
  }
</style>

<script is:inline>
  (function setupMultilangReader() {
    const pills = document.querySelectorAll('.lang-pill-btn');
    const statusEl = document.getElementById('translation-status');
    const statusMsg = statusEl?.querySelector('.status-msg');

    const articleBody = document.querySelector('article.prose');
    const articleTitle = document.querySelector('.post-title');
    const articleLead = document.querySelector('.post-lead');

    if (!articleBody) return;

    // Cache original content
    const originalElements = [];
    const elementsToTranslate = articleBody.querySelectorAll('h1, h2, h3, h4, p, li, blockquote, th, td');
    elementsToTranslate.forEach((el) => {
      // Don't translate code blocks or their direct contents
      if (!el.closest('pre') && !el.classList.contains('notranslate')) {
        originalElements.push({
          el,
          originalText: el.innerText.trim(),
        });
      }
    });

    if (articleTitle) {
      originalElements.push({ el: articleTitle, originalText: articleTitle.innerText.trim() });
    }
    if (articleLead) {
      originalElements.push({ el: articleLead, originalText: articleLead.innerText.trim() });
    }

    // Translation cache in sessionStorage
    const cache = {};

    async function translateText(text, targetLang) {
      if (!text || targetLang === 'ko') return text;
      
      const langPairMap = {
        'en': 'ko|en',
        'zh': 'ko|zh',
        'ja': 'ko|ja',
        'pl': 'ko|pl',
        'de-CH': 'ko|de', // Swiss German falls back to German
      };

      const pair = langPairMap[targetLang] || 'ko|en';
      const cacheKey = `${pair}::${text}`;
      if (cache[cacheKey]) return cache[cacheKey];

      try {
        const res = await fetch(
          `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${pair}`
        );
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          const trans = data.responseData.translatedText;
          cache[cacheKey] = trans;
          return trans;
        }
      } catch (e) {
        console.warn('Translation API fallback:', e);
      }
      return text;
    }

    async function applyArticleTranslation(targetLang) {
      pills.forEach((p) => {
        if (p.getAttribute('data-target-lang') === targetLang) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });

      if (targetLang === 'ko') {
        // Restore originals
        originalElements.forEach((item) => {
          item.el.innerText = item.originalText;
        });
        if (statusEl) statusEl.classList.add('hidden');
        return;
      }

      if (statusEl && statusMsg) {
        statusEl.classList.remove('hidden');
        statusMsg.textContent = `Translating article into ${targetLang.toUpperCase()} (Code blocks & equations protected)...`;
      }

      const langNames = {
        'en': 'English',
        'zh': '中文 (Chinese)',
        'ja': '日本語 (Japanese)',
        'pl': 'Polski (Polish)',
        'de-CH': 'Schweizerdeutsch / Deutsch (CH)',
      };

      // Batch translate in parallel chunks
      const promises = originalElements.map(async (item) => {
        if (!item.originalText) return;
        const translated = await translateText(item.originalText, targetLang);
        if (translated) {
          item.el.innerText = translated;
        }
      });

      await Promise.allSettled(promises);

      if (statusEl && statusMsg) {
        statusMsg.textContent = `✓ Displaying in ${langNames[targetLang] || targetLang.toUpperCase()}`;
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const target = pill.getAttribute('data-target-lang');
        if (target) {
          localStorage.setItem('site_lang', target);
          window.dispatchEvent(new CustomEvent('site-language-changed', { detail: { lang: target } }));
          applyArticleTranslation(target);
        }
      });
    });

    // Listen to global site-language changes
    window.addEventListener('site-language-changed', (e) => {
      if (e.detail && e.detail.lang) {
        applyArticleTranslation(e.detail.lang);
      }
    });

    // Initial check
    const currentLang = localStorage.getItem('site_lang') || 'ko';
    if (currentLang !== 'ko') {
      applyArticleTranslation(currentLang);
    }
  })();
</script>

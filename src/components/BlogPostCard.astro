---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  readingTimeMinutes?: number;
}

const { title, description, pubDate, slug, tags, readingTimeMinutes = 4 } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Auto-detect post key for i18n
const postKey = (
  slug.includes('ras') || title.includes('RAS') ? 'ras' :
  slug.includes('provenance') || title.includes('프로비넌스') ? 'prov' :
  slug.includes('tee') || title.includes('기밀') ? 'tee' :
  slug.includes('astro') || title.includes('Astro') ? 'astro' :
  undefined
);
---

<a href={`/blog/${slug}`} class="blog-card-link">
  <article class="card blog-card">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()} class="date-text">{formattedDate}</time>
      <span class="meta-dot">·</span>
      <span class="reading-time">{readingTimeMinutes} <span data-i18n="post.reading_time">min read</span></span>
    </div>

    <h3 class="blog-title" data-i18n={postKey ? `post.${postKey}.title` : undefined}>{title}</h3>
    <p class="blog-desc" data-i18n={postKey ? `post.${postKey}.desc` : undefined}>{description}</p>

    <div class="card-footer">
      <div class="tags-group">
        {tags.map((tag) => (
          <span class="tag-pill">#{tag}</span>
        ))}
      </div>
      <span class="read-more-arrow">→</span>
    </div>
  </article>
</a>

<style>
  .blog-card-link {
    display: block;
    height: 100%;
    color: inherit;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-secondary);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .meta-dot {
    opacity: 0.4;
  }

  .blog-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.45rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    transition: color var(--transition-fast);
  }

  .blog-card-link:hover .blog-title {
    color: var(--text-muted);
  }

  .blog-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.1rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .tags-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .read-more-arrow {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast);
  }

  .blog-card-link:hover .read-more-arrow {
    transform: translateX(3px);
    color: var(--text-primary);
  }
</style>

---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  readingTimeMinutes?: number;
}

const { title, description, pubDate, slug, tags, readingTimeMinutes = 4 } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="blog-card-link">
  <article class="card blog-card">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()} class="date-text">{formattedDate}</time>
      <span class="meta-dot">·</span>
      <span class="reading-time">{readingTimeMinutes} <span data-i18n="post.reading_time">분 소요</span></span>
    </div>

    <h3 class="blog-title">{title}</h3>
    <p class="blog-desc">{description}</p>

    <div class="card-footer">
      <div class="tags-group">
        {tags.map((tag) => (
          <span class="tag-pill">#{tag}</span>
        ))}
      </div>
      <span class="read-more-arrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </article>
</a>

<style>
  .blog-card-link {
    display: block;
    height: 100%;
    color: inherit;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .blog-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.6rem;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .blog-card-link:hover .blog-title {
    color: var(--accent-primary);
  }

  .blog-desc {
    font-size: 0.93rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .tags-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .read-more-arrow {
    color: var(--text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .blog-card-link:hover .read-more-arrow {
    transform: translateX(4px);
    color: var(--accent-primary);
  }
</style>

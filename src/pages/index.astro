---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../site.config';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title={`${SITE_CONFIG.name} | ${SITE_CONFIG.role}`}>
  <!-- Minimal Hero Bio Section -->
  <section class="minimal-hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-info">
          <div class="name-title-group">
            <h1 class="hero-name">{SITE_CONFIG.name} <span class="korean-sub">({SITE_CONFIG.koreanName})</span></h1>
          </div>
          <p class="hero-role-text" data-i18n="hero.role">{SITE_CONFIG.role}</p>
          <p class="hero-desc-text" data-i18n="hero.desc">{SITE_CONFIG.description}</p>
        </div>

        <div class="hero-quick-links">
          <a href={`mailto:${SITE_CONFIG.email}`} class="pill-link">
            <span>Email</span>
          </a>
          <a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer" class="pill-link">
            <span>GitHub</span>
          </a>
          <a href={SITE_CONFIG.social.scholar} target="_blank" rel="noopener noreferrer" class="pill-link">
            <span>Scholar</span>
          </a>
          <a href="/about" class="pill-link">
            <span data-i18n="hero.resume">CV / About</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Research & Projects Section (Front and Center) -->
  <section class="section-block">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-heading" data-i18n="section.featured_projects">주요 연구 & 프로젝트</h2>
        <a href="/projects" class="section-view-all" data-i18n="section.all_projects">전체 프로젝트 →</a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            category={project.data.category}
            github={project.data.github}
            demo={project.data.demo}
            paper={project.data.paper}
            slides={project.data.slides}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Writing / Blog Section -->
  <section class="section-block border-top">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-heading" data-i18n="section.recent_posts">기술 블로그 포스팅</h2>
        <a href="/blog" class="section-view-all" data-i18n="section.all_posts">전체 글 보기 →</a>
      </div>

      <div class="posts-grid">
        {recentPosts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .minimal-hero {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .name-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .hero-name {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .korean-sub {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hero-role-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .hero-desc-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hero-quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .pill-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .pill-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background-color: var(--bg-tertiary);
  }

  .section-block {
    padding: 2.75rem 0;
  }

  .section-block.border-top {
    border-top: 1px solid var(--border-color);
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .section-view-all {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .section-view-all:hover {
    color: var(--text-primary);
  }

  .projects-grid, .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .projects-grid, .posts-grid {
      grid-template-columns: 1fr;
    }
    .hero-top {
      flex-direction: column;
    }
  }
</style>

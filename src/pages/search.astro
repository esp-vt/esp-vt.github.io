---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const projects = await getCollection('projects');

const searchableData = [
  ...blogPosts.map((post) => ({
    type: 'blog',
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    url: `/blog/${post.slug}`,
    date: post.data.pubDate.toLocaleDateString('ko-KR'),
  })),
  ...projects.map((proj) => ({
    type: 'project',
    title: proj.data.title,
    description: proj.data.description,
    tags: proj.data.tags,
    category: proj.data.category,
    url: proj.data.github || proj.data.demo || '/projects',
    date: 'Project',
  })),
];
---

<BaseLayout title="Search | 통합 검색" description="Search articles, projects, and topics.">
  <div class="container page-container">
    <header class="page-header">
      <h1 class="page-title" data-i18n="nav.search">통합 검색</h1>
      <p class="page-desc">블로그 게시글, 프로젝트, 연구 주제를 실시간으로 검색합니다.</p>

      <div class="search-box-wrapper">
        <div class="search-input-group">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="게시글, 프로젝트, 기술 스택 검색... (Ctrl+K)"
            data-i18n-placeholder="search.placeholder"
            class="search-input"
            autocomplete="off"
            autofocus
          />
          <button id="clear-search-btn" class="clear-btn hidden" type="button" aria-label="Clear Search">✕</button>
        </div>
      </div>
    </header>

    <div id="search-status" class="search-status">
      <span id="results-count">전체 항목을 탐색할 수 있습니다.</span>
    </div>

    <div id="results-container" class="results-grid"></div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 3rem;
    padding-bottom: 5rem;
    max-width: 800px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-desc {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .search-box-wrapper {
    position: relative;
    max-width: 650px;
    margin: 0 auto;
  }

  .search-input-group {
    display: flex;
    align-items: center;
    background-color: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: all var(--transition-fast);
  }

  .search-input-group:focus-within {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .search-icon {
    color: var(--text-muted);
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    outline: none;
    background: none;
    font-family: inherit;
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .search-input::placeholder {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .clear-btn {
    color: var(--text-muted);
    font-size: 1.1rem;
    padding: 0.2rem 0.5rem;
    border-radius: 50%;
  }

  .clear-btn:hover {
    color: var(--text-primary);
  }

  .clear-btn.hidden {
    display: none;
  }

  .search-status {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .results-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.search-result-card) {
    display: block;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    transition: all var(--transition-fast);
  }

  :global(.search-result-card:hover) {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  :global(.result-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  :global(.result-title) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  :global(.result-desc) {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  :global(.result-tags) {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  :global(.highlight) {
    background-color: rgba(234, 179, 8, 0.25);
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
  }
</style>

<script define:vars={{ items: searchableData }}>
  const input = document.getElementById('search-input');
  const clearBtn = document.getElementById('clear-search-btn');
  const container = document.getElementById('results-container');
  const countEl = document.getElementById('results-count');

  function render(list, query = '') {
    if (list.length === 0) {
      container.innerHTML = `<div class="card" style="text-align: center; color: var(--text-muted); padding: 3rem;">검색 결과가 없습니다. 다른 검색어를 입력해 보세요.</div>`;
      countEl.textContent = '0개의 결과';
      return;
    }

    countEl.textContent = `총 ${list.length}개의 항목`;

    container.innerHTML = list.map((item) => {
      const typeBadge = item.type === 'blog' 
        ? '<span class="badge" style="background:#dbeafe; color:#1e40af;">Blog Post</span>'
        : '<span class="badge" style="background:#f3e8ff; color:#6b21a8;">Project</span>';

      return `
        <a href="${item.url}" class="search-result-card">
          <div class="result-top">
            ${typeBadge}
            <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">${item.date}</span>
          </div>
          <h3 class="result-title">${item.title}</h3>
          <p class="result-desc">${item.description}</p>
          <div class="result-tags">
            ${item.tags.map((t) => `<span class="badge">#${t}</span>`).join('')}
          </div>
        </a>
      `;
    }).join('');
  }

  function filterItems() {
    const q = input.value.trim().toLowerCase();
    if (!q) {
      clearBtn.classList.add('hidden');
      render(items);
      return;
    }

    clearBtn.classList.remove('hidden');

    const filtered = items.filter((item) => {
      const inTitle = item.title.toLowerCase().includes(q);
      const inDesc = item.description.toLowerCase().includes(q);
      const inTags = item.tags.some((t) => t.toLowerCase().includes(q));
      return inTitle || inDesc || inTags;
    });

    render(filtered, q);
  }

  input.addEventListener('input', filterItems);
  clearBtn.addEventListener('click', () => {
    input.value = '';
    input.focus();
    filterItems();
  });

  // Initial render
  render(items);
</script>

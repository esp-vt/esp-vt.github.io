---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { SITE_CONFIG } from '../site.config';

const publications = [
  {
    title: 'ConfML-Trust: Hardware-Anchored Confidential Machine Learning with Verifiable Data & Model Lineage',
    authors: 'Eunseong Park, et al.',
    venue: 'Virginia Tech Systems & Security Research / Preprint',
    year: '2026',
    paperLink: '#',
    codeLink: 'https://github.com/esp-vt',
  },
];
---

<BaseLayout title={`About | ${SITE_CONFIG.name}`} description="About Eunseong Park - AI Systems & Security Researcher at Virginia Tech">
  <div class="container about-container">
    <header class="about-header">
      <div class="profile-avatar">
        <span>👨‍💻</span>
      </div>
      <div class="profile-meta">
        <h1 class="profile-name">{SITE_CONFIG.name} <span class="korean-sub">({SITE_CONFIG.koreanName})</span></h1>
        <p class="profile-title" data-i18n="hero.role">{SITE_CONFIG.role}</p>
        <p class="profile-affil">{SITE_CONFIG.affiliation}</p>
        
        <div class="contact-badges">
          <span class="contact-pill">📧 <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a></span>
          <span class="contact-pill">📞 {SITE_CONFIG.phone}</span>
        </div>

        <div class="profile-links">
          <a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">GitHub</a>
          <a href={SITE_CONFIG.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">LinkedIn</a>
          <a href={SITE_CONFIG.social.scholar} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Google Scholar</a>
          <a href={`mailto:${SITE_CONFIG.email}`} class="btn btn-primary btn-sm" data-i18n="hero.contact">Email Me</a>
        </div>
      </div>
    </header>

    <div class="about-section card">
      <h2 class="section-title" data-i18n="about.intro_title">Introduction / 소개</h2>
      <p class="bio-text" data-i18n="about.bio_p1">
        안녕하세요! <strong>Virginia Tech</strong>에서 신뢰 실행 환경(Trusted Execution Environments, TEE),
        기밀 컴퓨팅(Confidential Computing), 데이터 프로비넌스(Verifiable Data Provenance) 및
        안전한 거대 언어 모델(Trustworthy LLMs) 시스템을 연구하고 있는 대학원 연구원 <strong>박은성 (Eunseong Park)</strong>입니다.
      </p>
      <p class="bio-text" data-i18n="about.bio_p2">
        AMD SEV-SNP, Intel TDX, NVIDIA Hopper H100 CC 등 최신 기밀 하드웨어를 활용하여,
        비신뢰 클라우드 환경에서도 머신러닝 파이프라인의 데이터 수집부터 모델 가중치 훈련 전 과정의
        기밀성(Confidentiality)과 변조 불가능한 이력(Lineage) 무결성을 하드웨어적으로 보증하는 시스템 아키텍처(ConfML-Trust)를 설계하고 있습니다.
      </p>
    </div>

    <div class="about-section card">
      <h2 class="section-title" data-i18n="about.interests_title">Research Interests / 주요 연구 분야</h2>
      <div class="interests-grid">
        <div class="interest-item">
          <div class="interest-icon">🛡️</div>
          <h4 data-i18n="about.interest_tee_title">Confidential Computing & TEE</h4>
          <p data-i18n="about.interest_tee_desc">AMD SEV-SNP, Intel TDX, Intel SGX, ARM CCA 기반 하드웨어 격리 메모리 및 원격 증명(Remote Attestation)</p>
        </div>
        <div class="interest-item">
          <div class="interest-icon">🤖</div>
          <h4 data-i18n="about.interest_llm_title">Trustworthy & Confidential LLMs</h4>
          <p data-i18n="about.interest_llm_desc">비신뢰 LLM 엔지니어링 에이전트 격리, 기밀 LoRA/PEFT 파인튜닝 및 악의적 데이터 오염 방지</p>
        </div>
        <div class="interest-item">
          <div class="interest-icon">🔗</div>
          <h4 data-i18n="about.interest_prov_title">Verifiable Data Provenance</h4>
          <p data-i18n="about.interest_prov_desc">VFS 계층 비우회적 프로비넌스 Shim, Merkle Tree 해시 체이닝 및 하드웨어 서명 Quote 기반 무결성 감사</p>
        </div>
        <div class="interest-item">
          <div class="interest-icon">⚡</div>
          <h4 data-i18n="about.interest_sec_title">Systems Security & Cloud Infrastructure</h4>
          <p data-i18n="about.interest_sec_desc">Linux IMA / dm-verity 커널 무결성, PCIe SPDM/IDE 버스 암호화, 고성능 분산 파이프라인 엔지니어링</p>
        </div>
      </div>
    </div>

    <!-- Publications -->
    <div class="about-section card">
      <h2 class="section-title" data-i18n="about.pub_section_title">Publications & Research / 주요 논문</h2>
      <div class="publications-list">
        {publications.map((pub) => (
          <div class="pub-card">
            <h4 class="pub-title">{pub.title}</h4>
            <p class="pub-authors">{pub.authors}</p>
            <div class="pub-venue">
              <span>{pub.venue} ({pub.year})</span>
              <div class="pub-actions">
                <a href={pub.paperLink} class="badge" data-i18n="projects.paper">📄 Paper / Preprint</a>
                <a href={pub.codeLink} target="_blank" rel="noopener noreferrer" class="badge">💻 GitHub</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Experience Timeline -->
    <div class="about-section card">
      <h2 class="section-title" data-i18n="section.timeline">Education & Timeline / 학력 및 이력</h2>
      <Timeline />
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    padding-top: 3rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1rem 0;
  }

  .profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-lg);
    background: var(--accent-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.2rem;
    box-shadow: 0 10px 25px var(--accent-glow);
    flex-shrink: 0;
  }

  .profile-name {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .korean-sub {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .profile-title {
    font-size: 1.1rem;
    color: var(--accent-primary);
    font-weight: 700;
    margin: 0.25rem 0 0.15rem;
  }

  .profile-affil {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: 0.65rem;
  }

  .contact-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .contact-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .contact-pill a {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .bio-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .interest-item {
    background-color: var(--bg-tertiary);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .interest-icon {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .interest-item h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .interest-item p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pub-card {
    background-color: var(--bg-tertiary);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .pub-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .pub-authors {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
  }

  .pub-venue {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--accent-primary);
    font-weight: 600;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pub-actions {
    display: flex;
    gap: 0.4rem;
  }

  @media (max-width: 640px) {
    .about-header {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
    .profile-links, .contact-badges {
      justify-content: center;
    }
  }
</style>
